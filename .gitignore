###############################################################################
# Terraform
###############################################################################

# Local .terraform directories
**/.terraform/*
.terraform/

# Terraform state
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup

# Terraform plan files
*.tfplan
*.plan
plan.out

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Terraform lock file
# Keep this committed for production modules
# Uncomment ONLY if you intentionally don't want it
# .terraform.lock.hcl

###############################################################################
# Variables / Secrets
###############################################################################

*.auto.tfvars
*.auto.tfvars.json

terraform.tfvars
terraform.tfvars.json

*.secrets.tfvars
*.secret.tfvars

local.tfvars
prod.tfvars
stage.tfvars
dev.tfvars

.env
.env.*
.envrc

*.pem
*.key
*.pfx
*.p12
*.cer
*.crt

